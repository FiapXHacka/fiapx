# Local-only dummy credentials for docker compose. Copy to .env: cp .env.example .env
# Never reuse these values in AWS.

# Postgres (superuser + one role per service, ADR-0009)
POSTGRES_USER=postgres
POSTGRES_PASSWORD=postgres-local
IDENTITY_DB_PASSWORD=identity-local
VIDEO_DB_PASSWORD=video-local
NOTIFICATION_DB_PASSWORD=notification-local

# RabbitMQ: these must match local/rabbitmq/definitions.json (hashes generated from these values).
# Management UI admin: fiapx / fiapx-local
RABBITMQ_IDENTITY_PASSWORD=identity-local
RABBITMQ_VIDEO_PASSWORD=video-local
RABBITMQ_PROCESSOR_PASSWORD=processor-local
RABBITMQ_NOTIFICATION_PASSWORD=notification-local

# S3-compatible storage (RustFS)
S3_ACCESS_KEY=fiapx
S3_SECRET_KEY=fiapx-local-secret
S3_BUCKET=fiapx-videos-local

# Host ports (change if something on your machine already uses them)
POSTGRES_PORT=15432
RABBITMQ_PORT=5672
RABBITMQ_UI_PORT=15672
REDIS_PORT=6379
S3_PORT=9000
S3_CONSOLE_PORT=9001
SMTP_PORT=1025
MAILPIT_UI_PORT=8025
GRAFANA_PORT=3000
OTLP_GRPC_PORT=4317
OTLP_HTTP_PORT=4318
GATEWAY_PORT=8080
GATEWAY_DASHBOARD_PORT=8088
IDENTITY_PORT=8091
VIDEO_API_PORT=8092
NOTIFICATION_PORT=8093
